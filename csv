# --------------------------------------------------
# PRICE CLEANER
# --------------------------------------------------
 
def clean_price(price_text):
    if not price_text:
        return None

    text = (
        str(price_text)
        .replace("\u202f", " ")
        .replace("\xa0", " ")
        .strip()
    )

    # Extract only the first price-like number
    match = re.search(
        r"\d{1,3}(?:[.,]\d{3})+(?:[.,]\d{1,2})?"
        r"|\d+(?:[.,]\d{1,2})?",
        text
    )

    if not match:
        return None

    value = match.group(0)

    # European format: 1.049,99
    if "." in value and "," in value:
        if value.rfind(",") > value.rfind("."):
            value = value.replace(".", "").replace(",", ".")
        else:
            # US/AU format: 1,049.99
            value = value.replace(",", "")

    # Thousand comma: 1,049
    elif "," in value:
        parts = value.split(",")

        if len(parts[-1]) == 3:
            value = value.replace(",", "")
        else:
            value = value.replace(",", ".")

    # Thousand dot: 1.049
    elif "." in value:
        parts = value.split(".")

        if len(parts[-1]) == 3:
            value = value.replace(".", "")

    try:
        return float(value)
    except ValueError:
        return None
 

 
 
 
