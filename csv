# MAIN
# --------------------------------------------------
def scrape_apple_all_countries():
 
    rows = []

 
    for country, cfg in COUNTRIES.items():
        try:
            print(f"Scraping Apple {country}...")
            data = scrape_apple_country(country, cfg)
            rows.append(data)
            print(f"✔ {country} → {data['SellingPrice_Local']}\n")
 
        except Exception as e:
            print(f"❌ {country} failed → {e}\n")
 
    df = pd.DataFrame(rows)
    return df
 
 
