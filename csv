# --------------------------------------------------
# SCRAPER
# --------------------------------------------------
def scrape_apple_country(region, config):
 
    pst_zone = datetime.now(pytz.timezone("America/Los_Angeles"))
 
    try:
        options = Options()
        options.add_argument("--start-maximized")

        # ✅ Pass options into driver
        driver = webdriver.Chrome(options=options)
        wait = WebDriverWait(driver, 30)
        driver.get(config["url"])
        time.sleep(4)
 
        # for xpath in config["clicks"]:
        #     wait.until(EC.element_to_be_clickable((By.XPATH, xpath))).click()
        #     time.sleep(5)
 
        price_el = wait.until(
            EC.presence_of_element_located(
                (By.XPATH, config["price_el"])
            )
        )
 
        raw_price = price_el.text.strip()
        price = clean_price(raw_price)
        now = datetime.now()
        return {
            "Retailer": "Apple Direct",
            "ProductCode": "MacBook Pro",
            "DFN": "Apple MacBook Pro",
            "SpecsCombo": "A18Pro|8GB|256GB|13",
            "SellingPrice_Local": price,
            "Region": region,
            "ScrapedAt": now.strftime("%Y/%m/%d %H:%M:%S"),
            "dd": now.day,
            "mm": now.month,
            "yyyy": now.year
        }
 
    finally:
        driver.quit()
 
 
